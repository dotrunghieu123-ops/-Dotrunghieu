using System;
using System.Collections.Generic;
using System.Windows.Forms;

namespace _4._1
{
    public partial class Form1 : Form
    {
        public Form1()
        {
            InitializeComponent();

            // Gọi các hàm thiết lập
            SetMaskedTextBox();
            SetDateTimePicker();
            LoadCourses();

            // Gắn sự kiện nút Đăng ký
            btnRegister.Click += btnRegister_Click;
        }

        // ==============================
        // 1. CẤU HÌNH SỐ ĐIỆN THOẠI
        // ==============================
        private void SetMaskedTextBox()
        {
            mtxtPhone.Mask = "(000) 000-0000";
        }

        // ==============================
        // 2. CẤU HÌNH NGÀY SINH
        // ==============================
        private void SetDateTimePicker()
        {
            dtpBirthDate.Format = DateTimePickerFormat.Custom;
            dtpBirthDate.CustomFormat = "dd/MM/yyyy";
        }

        // ==============================
        // 3. NẠP DANH SÁCH KHÓA HỌC
        // ==============================
        private void LoadCourses()
        {
            List<Course> courses = new List<Course>()
            {
                new Course { Id = 1, Name = "Lập trình C#" },
                new Course { Id = 2, Name = "Lập trình Java" },
                new Course { Id = 3, Name = "Lập trình Python" },
                new Course { Id = 4, Name = "Lập trình Web" }
            };

            // Binding Data
            cboCourse.DataSource = courses;

            // Nội dung hiển thị
            cboCourse.DisplayMember = "Name";

            // Giá trị thực tế
            cboCourse.ValueMember = "Id";
        }

        // ==============================
        // 4. NÚT ĐĂNG KÝ
        // ==============================
        private void btnRegister_Click(object sender, EventArgs e)
        {
            string name = txtName.Text;
            string phone = mtxtPhone.Text;

            // Ngày sinh
            string birthDate = dtpBirthDate.Value.ToString("dd/MM/yyyy");

            // Khóa học
            string course = cboCourse.Text;

            // Giới tính
            string gender = "";

            if (rdoMale.Checked)
            {
                gender = "Nam";
            }
            else if (rdoFemale.Checked)
            {
                gender = "Nữ";
            }
            else
            {
                gender = "Chưa chọn";
            }

            // Môn học yêu thích
            List<string> subjects = new List<string>();

            if (chkCSharp.Checked)
            {
                subjects.Add("C#");
            }

            if (chkJava.Checked)
            {
                subjects.Add("Java");
            }

            if (chkPython.Checked)
            {
                subjects.Add("Python");
            }

            string subjectText;

            if (subjects.Count > 0)
            {
                subjectText = string.Join(", ", subjects);
            }
            else
            {
                subjectText = "Chưa chọn";
            }

            // Hiển thị thông tin
            string message =
                "THÔNG TIN ĐĂNG KÝ\n" +
                "--------------------------\n" +
                "Họ tên: " + name + "\n" +
                "Số điện thoại: " + phone + "\n" +
                "Ngày sinh: " + birthDate + "\n" +
                "Giới tính: " + gender + "\n" +
                "Khóa học: " + course + "\n" +
                "Môn học: " + subjectText;

            MessageBox.Show(
                message,
                "Đăng ký thành công",
                MessageBoxButtons.OK,
                MessageBoxIcon.Information
            );
        }
    }

    // ==============================
    // CLASS KHÓA HỌC
    // ==============================
    public class Course
    {
        public int Id { get; set; }

        public string Name { get; set; }
    }
}
